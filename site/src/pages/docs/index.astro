---
/** The docs home at /docs: one card per page, grouped by sidebar section. */
import { getCollection } from "astro:content";
import { docsGroups } from "../../config";
import DocsLayout from "../../layouts/DocsLayout.astro";
import { docHref, docsNav } from "../../lib/docs";

const nav = docsNav(await getCollection("docs"), docsGroups);
---

<DocsLayout
  title="foreman documentation"
  description="How to install foreman, delegate coding tasks from Claude Code to Codex or agy, supervise the runs, and look up every command and setting."
  path="/docs"
  nav={nav}
>
  <p>
    Every page is also served as Markdown, and <a href="/llms.txt">llms.txt</a>{" "}
    lists them all for agents.
  </p>
  {nav.map((group) => (
    <section aria-labelledby={`group-${group.id}`}>
      <h2 id={`group-${group.id}`}>{group.label}</h2>
      <ul class="not-prose grid gap-4 sm:grid-cols-2">
        {group.items.map((item) => (
          <li class="docs-card">
            <a
              href={docHref(item.id)}
              class="text-ink font-medium no-underline"
            >
              {item.title}
            </a>
            <p class="text-ink-2 mt-1 text-sm">{item.description}</p>
          </li>
        ))}
      </ul>
    </section>
  ))}
</DocsLayout>
