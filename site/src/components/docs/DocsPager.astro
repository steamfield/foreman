---
/** Previous and next docs pages in sidebar order, as two cards that are whole links. */
import { docHref, type NavItem } from "../../lib/docs";

interface Props {
  prev?: NavItem | undefined;
  next?: NavItem | undefined;
}
const { prev, next } = Astro.props;
---

{(prev || next) && (
  <nav aria-label="Pagination" class="docs-pager">
    {prev && (
      <a href={docHref(prev.id)} rel="prev">
        <span class="docs-pager-dir">
          <span class="docs-pager-arrow" aria-hidden="true">
            ←
          </span>{" "}
          Previous
        </span>
        <span class="docs-pager-title">{prev.title}</span>
      </a>
    )}
    {next && (
      <a href={docHref(next.id)} rel="next" class="docs-pager-next">
        <span class="docs-pager-dir">
          Next{" "}
          <span class="docs-pager-arrow" aria-hidden="true">
            →
          </span>
        </span>
        <span class="docs-pager-title">{next.title}</span>
      </a>
    )}
  </nav>
)}
