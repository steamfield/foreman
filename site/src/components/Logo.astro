---
// The foreman mark: three chevrons moving right, the lead (orange) in front. Inlined
// from the brand pack in public/brand/ so the header, the favicon and the brand files
// share one drawing; `make brand` renders the WebP sizes from the same SVGs.
import lockup from "../../public/brand/foreman-lockup-light.svg?raw";
import mark from "../../public/brand/foreman-mark-light.svg?raw";

interface Props {
  /** Rendered height in pixels; the width follows the drawing. */
  size?: number;
  class?: string;
  /** Show the outlined "foreman" wordmark beside the mark. */
  wordmark?: boolean;
}
const { size = 24, class: className, wordmark = false } = Astro.props;
// The brand files carry a <title>; the inline copy is named through aria-label instead.
const svg = (wordmark ? lockup : mark)
  .replace(/\s*<title>[^<]*<\/title>/, "")
  .replace(
    "<svg ",
    `<svg role="img" aria-label="foreman" height="${size}" style="width:auto" `,
  );
---

<span class:list={["inline-flex items-center", className]} set:html={svg} />
